{
  "name": "harnessy",
  "version": "0.30.1",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=22"
  },
  "description": "Workspace local para coordenar agentes de desenvolvimento",
  "type": "module",
  "scripts": {
    "start": "bunx --bun tauri dev",
    "dev": "bunx --bun vite --host 127.0.0.1",
    "build": "bunx --bun tsc --noEmit && bunx --bun vite build",
    "desktop:build": "bunx --bun tauri build",
    "app": "bun scripts/app.mjs open",
    "app:build": "bun scripts/app.mjs build",
    "app:install": "bun scripts/app.mjs install",
    "app:dogfood": "bun scripts/app.mjs dogfood",
    "app:preview": "bun scripts/app.mjs preview",
    "check": "bunx --bun tsc --noEmit && bun scripts/check-version.mjs",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "bunx --bun tauri",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "check:quick": "bun run lint && bun run format:check && bun run check && bun run test",
    "verify": "bun run check:quick && bun run build",
    "verify:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked -- -D warnings",
    "harness:score": "node node_modules/harness-score/dist/cli.js . --config .harness-score.json",
    "harness:report": "node scripts/harness-report.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "harness-score": "1.8.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
